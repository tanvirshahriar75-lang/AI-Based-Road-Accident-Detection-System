{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/road-accident/annotation.schema.json",
  "title": "Road accident event annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "timestamp_sec", "event_type"],
  "properties": {
    "video_id": { "type": "string", "minLength": 1 },
    "timestamp_sec": { "type": "number", "minimum": 0 },
    "event_type": {
      "type": "string",
      "enum": ["collision", "near_miss", "rollover", "vehicle_fall", "unknown"]
    },
    "involved_track_ids": {
      "type": "array",
      "items": { "type": "integer" },
      "uniqueItems": true
    },
    "annotator": { "type": "string" },
    "notes": { "type": "string" }
  }
}
